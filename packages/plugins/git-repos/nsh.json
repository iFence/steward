{
  "name": "Git Repositories",
  "id": "it.aspirin.git-repos",
  "version": "0.2.0",
  "build": 2,
  "capabilities": {
    "host": [
      "steward.storage.get",
      "steward.storage.set",
      "steward.fs.pick",
      "steward.fs.walk",
      "steward.fs.readText",
      "steward.system.openPath",
      "steward.system.revealPath",
      "steward.exec.run",
      "steward.exec.cancel"
    ],
    "process": {
      "execute": ["git.exe"]
    },
    "openUrl": {
      "schemes": ["https"]
    }
  }
}
