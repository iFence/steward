{
  "name": "Git Repositories",
  "id": "it.aspirin.git-repos",
  "version": "0.1.0",
  "build": 1,
  "capabilities": {
    "host": [
      "steward.storage.get",
      "steward.storage.set",
      "steward.fs.pick",
      "steward.fs.walk",
      "steward.fs.readText",
      "steward.system.openPath",
      "steward.system.revealPath"
    ],
    "openUrl": {
      "schemes": ["https"]
    }
  }
}
