{
  "name": "Local Files",
  "id": "it.aspirin.local-files",
  "version": "0.1.0",
  "build": 1,
  "resolve": {
    "alias": {
      "@steward/extension-api": "../../extension-api/src/host.ts"
    }
  },
  "capabilities": {
    "host": [
      "steward.fs.pick",
      "steward.fs.walk",
      "steward.fs.readText",
      "steward.system.openPath",
      "steward.system.revealPath",
      "steward.system.applications",
      "steward.system.openWith"
    ]
  }
}
