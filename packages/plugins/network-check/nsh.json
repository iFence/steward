{
  "name": "Network Check",
  "id": "it.aspirin.network-check",
  "version": "0.1.0",
  "build": 1,
  "resolve": {
    "alias": {
      "@steward/extension-api": "../../extension-api/src/host.ts"
    }
  },
  "capabilities": {
    "host": [
      "steward.net.fetch",
      "steward.secrets.get",
      "steward.secrets.set",
      "steward.secrets.delete"
    ],
    "network": {
      "http": [
        {
          "host": "api.github.com",
          "schemes": ["https"],
          "methods": ["GET"],
          "pathPrefixes": ["/rate_limit"]
        }
      ]
    }
  }
}
