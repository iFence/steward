{
  "name": "@steward/extension-api",
  "version": "0.1.0",
  "description": "Type declarations and runtime polyfills for Steward plugin developers.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "gen:styles": "node scripts/gen-styles.mjs",
    "check:styles": "node scripts/gen-styles.mjs --check",
    "build": "node scripts/gen-styles.mjs && esbuild src/index.ts --bundle --format=cjs --outfile=dist/index.js --sourcemap",
    "typecheck": "tsc --noEmit"
  }
}
