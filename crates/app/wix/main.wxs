<?xml version='1.0' encoding='windows-1252'?>
<!--
  WiX installer for the Steward launcher.

  Build with:

      cargo wix -p steward-app

  The installer installs steward-app.exe and the sibling
  steward-plugin-runtime.exe to Program Files (the runtime is required for
  plugins), registers the product icon in Add/Remove Programs, and adds a
  Start Menu shortcut.
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'
    xmlns:util='http://schemas.microsoft.com/wix/UtilExtension'>

    <Product
        Id='*'
        Name='Steward'
        UpgradeCode='9A77B532-62EB-479B-8422-32164A65BFA9'
        Manufacturer='Steward contributors'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Manufacturer='Steward contributors'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            AllowSameVersionUpgrades='yes'
            IgnoreRemoveFailure='yes'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Steward Installation'/>

        <Icon Id='ProductICO' SourceFile='../../assets/icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO'/>

        <!-- "Run Steward" checkbox on the Finish dialog (checked by default). -->
        <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOX' Value='1'/>
        <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT' Value='Run Steward'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <!-- Resolved to the system directory so the taskkill fallback can
                 be launched before the previous product's files are removed. -->
            <Directory Id='SystemFolder'/>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='Steward'>
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile'
                            DiskId='1'
                            Source='../../crates/app/wix/License.rtf'
                            KeyPath='yes'/>
                    </Component>

                    <Component Id='binary0' Guid='*'>
                        <File
                            Id='exe0'
                            Name='steward-app.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\steward-app.exe'
                            KeyPath='yes'/>
                    </Component>

                    <!-- Plugin host runtime: resolved as a sibling of the app
                         executable by `HostConfig::from_env`. -->
                    <Component Id='runtime0' Guid='*'>
                        <File
                            Id='runtime0exe'
                            Name='steward-plugin-runtime.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\steward-plugin-runtime.exe'
                            KeyPath='yes'/>
                    </Component>

                    <!-- Optional privileged enumerator: the app connects to it
                         over a named pipe when it is running, and falls back to
                         its own directory walk otherwise. -->
                    <Component Id='helper0' Guid='*'>
                        <File
                            Id='helper0exe'
                            Name='steward-index-helper.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\steward-index-helper.exe'
                            KeyPath='yes'/>
                        <!-- Auto-start LocalSystem service: reads $MFT and
                             streams records to the app over a named pipe.
                             `Vital='no'` keeps a service failure from aborting
                             the whole install; the app then uses its own walk. -->
                        <ServiceInstall
                            Id='StewardIndexHelperInstall'
                            Name='StewardIndexHelper'
                            DisplayName='Steward Index Helper'
                            Description='Reads the NTFS $MFT so Steward file search starts fast.'
                            Type='ownProcess'
                            Start='auto'
                            ErrorControl='normal'
                            Arguments='--service'
                            Vital='no'/>
                        <ServiceControl
                            Id='StewardIndexHelperControl'
                            Name='StewardIndexHelper'
                            Start='install'
                            Stop='both'
                            Remove='uninstall'
                            Wait='yes'/>
                    </Component>
                </Directory>
            </Directory>

            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='Steward'/>
            </Directory>
        </Directory>

        <DirectoryRef Id='ApplicationProgramsFolder'>
            <Component Id='ApplicationShortcut' Guid='*'>
                <Shortcut Id='ApplicationStartMenuShortcut'
                    Name='Steward'
                    Description='Steward launcher'
                    Target='[#exe0]'
                    WorkingDirectory='APPLICATIONFOLDER'/>
                <RemoveFolder Id='RemoveApplicationProgramsFolder' On='uninstall'/>
                <RegistryValue Root='HKCU' Key='Software\Steward' Name='installed'
                    Type='integer' Value='1' KeyPath='yes'/>
            </Component>
        </DirectoryRef>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs the Steward launcher.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='License'/>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='runtime0'/>
            <ComponentRef Id='helper0'/>
            <ComponentRef Id='ApplicationShortcut'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <!-- Show a "Run Steward" checkbox on the Finish dialog (checked by default) and
             launch Steward after install when it is checked. The WixUI library defines
             these as hidden properties, so override them with SetProperty instead of
             redefining the Property symbols. -->
        <SetProperty Id='WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT' Value='Run Steward' Before='CostInitialize'/>
        <SetProperty Id='WIXUI_EXITDIALOGOPTIONALCHECKBOX' Value='1' Before='CostInitialize'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>

            <!-- The stock ExitDialog only publishes EndDialog (Order 999) on Finish; add the
                 launch before it, gated on the checkbox. -->
            <Publish Dialog='ExitDialog' Control='Finish' Event='DoAction' Value='LaunchApplication' Order='1'>WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1</Publish>
        </UI>

        <CustomAction
            Id='LaunchApplication'
            Directory='APPLICATIONFOLDER'
            ExeCommand='[#exe0]'
            Execute='immediate'
            Return='asyncNoWait'
            Impersonate='yes'/>

        <!-- Force any running instance to exit before `RemoveExistingProducts`
             (scheduled by MajorUpgrade at afterInstallInitialize) removes the
             previous product's files. `util:CloseApplication` is graceful but
             only runs just before InstallFiles, which is too late for that
             removal; taskkill guarantees the executable is not locked, and /T
             also stops the plugin-runtime child. Matching is by image name, so
             local debug/release builds are closed too. -->
        <CustomAction
            Id='StopRunningSteward'
            Directory='SystemFolder'
            ExeCommand='taskkill.exe /IM steward-app.exe /F /T'
            Execute='immediate'
            Return='ignore'/>
        <CustomAction
            Id='StopRunningStewardRuntime'
            Directory='SystemFolder'
            ExeCommand='taskkill.exe /IM steward-plugin-runtime.exe /F /T'
            Execute='immediate'
            Return='ignore'/>
        <CustomAction
            Id='StopRunningStewardHelper'
            Directory='SystemFolder'
            ExeCommand='taskkill.exe /IM steward-index-helper.exe /F /T'
            Execute='immediate'
            Return='ignore'/>

        <!-- Graceful fallback: a normal close and an end-session message are
             tried first; TerminateProcess is the fallback after the timeout. -->
        <util:CloseApplication
            Id='CloseStewardApp'
            Target='steward-app.exe'
            Description='Steward is running and will be closed to install the update.'
            CloseMessage='yes'
            EndSessionMessage='yes'
            RebootPrompt='no'
            TerminateProcess='1'
            Timeout='5'/>
        <util:CloseApplication
            Id='CloseStewardRuntime'
            Target='steward-plugin-runtime.exe'
            Description='The Steward plugin runtime is running and will be closed to install the update.'
            CloseMessage='yes'
            EndSessionMessage='yes'
            RebootPrompt='no'
            TerminateProcess='1'
            Timeout='5'/>
        <util:CloseApplication
            Id='CloseStewardHelper'
            Target='steward-index-helper.exe'
            Description='The Steward index helper is running and will be closed to install the update.'
            CloseMessage='yes'
            EndSessionMessage='yes'
            RebootPrompt='no'
            TerminateProcess='1'
            Timeout='5'/>

        <!-- Keep the per-user autostart entry in sync with what is installed:
             rewrite it to the freshly installed executable (only when the user
             had autostart on), and remove it on a real uninstall. During a
             major upgrade the old product's uninstall carries
             UPGRADINGPRODUCTCODE, so the entry survives for SyncAutostart. -->
        <CustomAction
            Id='SyncAutostart'
            Directory='APPLICATIONFOLDER'
            ExeCommand='"[#exe0]" --sync-autostart'
            Execute='immediate'
            Return='ignore'/>
        <CustomAction
            Id='UnregisterAutostart'
            Directory='APPLICATIONFOLDER'
            ExeCommand='"[#exe0]" --unregister-autostart'
            Execute='immediate'
            Return='ignore'/>

        <InstallExecuteSequence>
            <Custom Action='StopRunningSteward' Before='RemoveExistingProducts'>VersionNT &gt; 400</Custom>
            <Custom Action='StopRunningStewardRuntime' After='StopRunningSteward'>VersionNT &gt; 400</Custom>
            <Custom Action='StopRunningStewardHelper' After='StopRunningStewardRuntime'>VersionNT &gt; 400</Custom>
            <Custom Action='SyncAutostart' After='InstallFiles'>NOT REMOVE</Custom>
            <Custom Action='UnregisterAutostart' Before='RemoveFiles'>(REMOVE="ALL") AND NOT UPGRADINGPRODUCTCODE</Custom>
        </InstallExecuteSequence>

        <WixVariable Id='WixUILicenseRtf' Value='../../crates/app/wix/License.rtf'/>

    </Product>

</Wix>
