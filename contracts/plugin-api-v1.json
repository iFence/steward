{
  "contractVersion": 1,
  "hostApiVersion": "0.5.0",
  "errorEnvelopeVersion": 1,
  "errorEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "code", "message", "retryable"],
    "properties": {
      "version": { "const": 1 },
      "code": {
        "enum": [
          "permission_denied",
          "feature_unavailable",
          "timeout",
          "resource_exhausted",
          "host_failure",
          "invalid_input",
          "cancelled",
          "confirmation_denied",
          "io_failure"
        ]
      },
      "message": { "type": "string" },
      "retryable": { "type": "boolean" }
    },
    "examples": [
      {
        "version": 1,
        "code": "permission_denied",
        "message": "clipboard write is not granted",
        "retryable": false
      }
    ]
  },
  "errors": [
    { "code": "permission_denied", "retryable": false },
    { "code": "feature_unavailable", "retryable": false },
    { "code": "timeout", "retryable": true },
    { "code": "resource_exhausted", "retryable": true },
    { "code": "host_failure", "retryable": true },
    { "code": "invalid_input", "retryable": false },
    { "code": "cancelled", "retryable": true },
    { "code": "confirmation_denied", "retryable": false },
    { "code": "io_failure", "retryable": false }
  ],
  "features": [
    "host_info",
    "runtime_feature_discovery",
    "steward.feedback",
    "steward.navigation",
    "steward.preferences"
