{
  "contractVersion": 2,
  "hostApiVersion": "1.1.0",
  "errorEnvelopeVersion": 1,
  "stability": {
    "line": "1.x",
    "stableSince": "1.0.0",
    "minimumSupportedApiVersion": "0.3.0",
    "policy": {
      "patch": "Patch releases may fix implementation behavior but cannot remove calls, fields, events, or capability scopes, and cannot change their meaning.",
      "minor": "Minor releases may add calls, optional request fields, optional response fields, events, features, and capability scopes. Existing stable inputs and successful responses keep their meaning.",
      "major": "A major release may remove or change stable behavior only after the documented deprecation window and an explicit migration line.",
      "deprecation": "A deprecated public entry remains available for at least one minor release in the current major line. Its contract record must name the replacement and the first removal version. Removal happens only in a later major release."
    },
    "deprecations": []
  },
  "failureStates": [
    {
      "state": "disabled",
      "code": "feature_unavailable",
      "meaning": "The running host does not provide the requested API family."
    },
    {
      "state": "revoked",
      "code": "permission_denied",
      "meaning": "No active capability grant matches the plugin, publisher, version, permission, and scope."
    },
    {
      "state": "expired",
      "code": "permission_denied",
      "meaning": "A previously active resource grant or package-version grant no longer matches."
    },
    {
      "state": "malformed",
      "code": "invalid_input",
      "meaning": "The request fails schema, range, path, or semantic validation."
    },
    {
      "state": "timedOut",
      "code": "timeout",
      "meaning": "A bounded host operation exceeded its deadline."
    },
    {
      "state": "cancelled",
      "code": "cancelled",
      "meaning": "The plugin or user cancelled the operation before completion."
    },
    {
      "state": "resourceExhausted",
      "code": "resource_exhausted",
      "meaning": "The request or API family exceeded a payload, queue, concurrency, or output quota."
    }
  ],
  "families": [
    {
      "name": "preferences",
      "description": "Read host-rendered, plugin-scoped preference values supplied at launch.",
      "maxOperationTimeoutMs": 5000,
      "quotas": [
        {
          "subject": "preference key",
          "limit": "256 UTF-8 bytes per key",
          "behavior": "invalid_input"
        },
        {
          "subject": "request payload",
          "limit": "4 KiB",
          "behavior": "resource_exhausted"
        }
      ]
    },
    {
      "name": "feedback",
      "description": "Show host-rendered toasts, confirmations, and progress events.",
      "maxOperationTimeoutMs": 300000,
      "quotas": [
        {
          "subject": "toast",
          "limit": "title 128 bytes; message 1024 bytes",
          "behavior": "invalid_input"
        },
        {
          "subject": "confirmation",
          "limit": "title 128 bytes; message 4096 bytes; labels 64 bytes each",
          "behavior": "invalid_input"
        },
        {
          "subject": "progress",
          "limit": "id 128 bytes; message 1024 bytes",
          "behavior": "invalid_input"
        }
      ]
    },
    {
      "name": "clipboard",
      "description": "Read recent host clipboard entries or replace the current text value.",
      "maxOperationTimeoutMs": 5000,
      "quotas": [
        {
          "subject": "clipboard history",
          "limit": "50 entries; 100000 bytes per entry",
          "behavior": "oldest entries are omitted"
        },
        {
          "subject": "clipboard write",
          "limit": "100000 bytes",
          "behavior": "resource_exhausted"
        }
      ]
    },
    {
      "name": "storage",
      "description": "Read and write plugin-private string storage that survives package updates.",
      "maxOperationTimeoutMs": 5000,
      "quotas": [
        {
          "subject": "storage key",
          "limit": "256 UTF-8 bytes",
          "behavior": "invalid_input"
        },
        {
          "subject": "storage value",
          "limit": "1 MiB",
          "behavior": "resource_exhausted"
        }
      ]
    },
    {
      "name": "secrets",
      "description": "Store plugin-private credentials with Windows DPAPI protection.",
      "maxOperationTimeoutMs": 5000,
      "quotas": [
        {
          "subject": "secret key",
          "limit": "1 through 128 bytes matching [A-Za-z0-9][A-Za-z0-9._-]*",
          "behavior": "invalid_input"
        },
        {
          "subject": "secret value",
          "limit": "2560 UTF-8 bytes",
          "behavior": "resource_exhausted"
        },
        {
          "subject": "stored secrets",
          "limit": "64 secrets per plugin",
          "behavior": "resource_exhausted"
        }
      ]
    },
    {
      "name": "calendar",
      "description": "Read Steward's cached holiday and adjusted-workday schedule.",
      "maxOperationTimeoutMs": 20000,
      "quotas": [
        {
          "subject": "calendar year",
          "limit": "0 through 65535",
          "behavior": "invalid_input"
        },
        {
          "subject": "holiday requests",
          "limit": "16 queued requests",
          "behavior": "resource_exhausted"
        }
      ]
    },
    {
      "name": "navigation",
      "description": "Close the plugin surface, return to the launcher, and set a bounded page title.",
      "maxOperationTimeoutMs": 5000,
      "quotas": [
        {
          "subject": "page title",
          "limit": "1 through 128 UTF-8 bytes",
          "behavior": "invalid_input"
        }
      ]
    },
    {
      "name": "filesystem",
      "description": "Ask the user for selected roots and perform bounded text and metadata operations inside active path grants.",
      "maxOperationTimeoutMs": 30000,
      "quotas": [
        {
          "subject": "path",
          "limit": "32768 bytes",
          "behavior": "invalid_input"
        },
        {
          "subject": "walk",
          "limit": "20000 results; depth 64; timeout 30000 ms",
          "behavior": "invalid_input or timeout"
        },
        {
          "subject": "read and write",
          "limit": "4 MiB",
          "behavior": "resource_exhausted"
        },
        {
          "subject": "filesystem work queue",
          "limit": "16 queued operations",
          "behavior": "resource_exhausted"
        }
      ]
    },
    {
      "name": "system",
      "description": "Discover installed applications and open or reveal user-selected paths through the host.",
      "maxOperationTimeoutMs": 20000,
      "quotas": [
        {
          "subject": "installed applications",
          "limit": "2000 entries",
          "behavior": "additional entries are omitted"
        },
        {
          "subject": "system work queue",
          "limit": "8 queued operations",
          "behavior": "resource_exhausted"
        }
      ]
    },
    {
      "name": "network",
      "description": "Perform scoped HTTPS requests with host-owned redirect, size, timeout, and grant enforcement.",
      "maxOperationTimeoutMs": 30000,
      "quotas": [
        {
          "subject": "request",
          "limit": "URL 8192 bytes; 32 headers; body 1 MiB",
          "behavior": "invalid_input or resource_exhausted"
        },
        {
          "subject": "response",
          "limit": "4 MiB",
          "behavior": "resource_exhausted"
        },
        {
          "subject": "network operation",
          "limit": "timeout 100 through 30000 ms; 5 redirects",
          "behavior": "timeout or resource_exhausted"
        },
        {
          "subject": "network queue",
          "limit": "8 queued requests",
          "behavior": "resource_exhausted"
        }
      ]
    },
    {
      "name": "process",
      "description": "Run an exact approved executable through the launcher broker without a shell.",
      "maxOperationTimeoutMs": 120000,
      "quotas": [
        {
          "subject": "arguments",
          "limit": "256 arguments; 32768 bytes total",
          "behavior": "resource_exhausted"
        },
        {
          "subject": "controlled process",
          "limit": "timeout 1 through 120000 ms; output 4 MiB",
          "behavior": "timeout or resource_exhausted"
        },
        {
          "subject": "process work and pending requests",
          "limit": "8 queued tasks; 64 pending requests",
          "behavior": "resource_exhausted"
        }
      ]
    }
  ],
  "errorEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "code", "message", "retryable"],
    "properties": {
      "version": { "const": 1 },
      "code": {
        "enum": [
          "permission_denied",
          "feature_unavailable",
          "timeout",
          "resource_exhausted",
          "host_failure",
          "invalid_input",
          "cancelled",
          "confirmation_denied",
          "io_failure"
        ]
      },
      "message": { "type": "string" },
      "retryable": { "type": "boolean" }
    },
    "examples": [
      {
        "version": 1,
        "code": "permission_denied",
        "message": "clipboard write is not granted",
        "retryable": false
      }
    ]
  },
  "errors": [
    {
      "code": "permission_denied",
      "retryable": false,
      "description": "The package declaration or an active grant does not authorize the request."
    },
    {
      "code": "feature_unavailable",
      "retryable": false,
      "description": "The running host does not provide the requested feature or API family."
    },
    {
      "code": "timeout",
      "retryable": true,
      "description": "A bounded host operation exceeded its deadline."
    },
    {
      "code": "resource_exhausted",
      "retryable": true,
      "description": "A payload, output, queue, concurrency, or platform quota was exceeded."
    },
    {
      "code": "host_failure",
      "retryable": true,
      "description": "Steward could not complete the host operation."
    },
    {
      "code": "invalid_input",
      "retryable": false,
      "description": "The request failed schema, range, path, or semantic validation."
    },
    {
      "code": "cancelled",
      "retryable": true,
      "description": "The operation was cancelled before completion."
    },
    {
      "code": "confirmation_denied",
      "retryable": false,
      "description": "The user declined a host-rendered confirmation."
    },
    {
      "code": "io_failure",
      "retryable": false,
      "description": "A filesystem or system-open operation failed at the operating-system boundary."
    }
  ],
  "features": [
    "host_info",
    "runtime_feature_discovery",
    "steward.feedback",
    "steward.navigation",
    "steward.preferences",
    "steward.secrets"
  ],
  "events": [
    {
      "name": "steward.command",
      "description": "A focused plugin window received another command invocation.",
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "input"],
        "properties": {
          "command": { "type": "string" },
          "input": { "type": "string" }
        },
        "examples": [{ "command": "run", "input": "needle" }]
      }
    },
    {
      "name": "steward.theme",
      "description": "The host accent color or dark-mode setting changed.",
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accent", "dark"],
        "properties": {
          "accent": { "type": "string" },
          "dark": { "type": "boolean" }
        },
        "examples": [{ "accent": "#863bff", "dark": true }]
      }
    },
    {
      "name": "steward.visibility",
      "description": "The plugin surface became active or inactive.",
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["visible"],
        "properties": {
          "visible": { "type": "boolean" }
        },
        "examples": [{ "visible": true }]
      }
    },
    {
      "name": "steward.progress",
      "description": "A progress update previously submitted by this plugin was accepted.",
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "message"],
        "properties": {
          "id": { "type": "string" },
          "message": { "type": "string" },
          "current": { "type": ["integer", "null"], "minimum": 0 },
          "total": { "type": ["integer", "null"], "minimum": 0 }
        },
        "examples": [{ "id": "index", "message": "Indexing", "current": 2, "total": 10 }]
      }
    }
  ],
  "capabilities": [
    { "permission": "steward.preferences.get", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.preferences.all", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.feedback.toast", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.feedback.confirm", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.feedback.progress", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.clipboard.history", "scope": "host=steward", "sensitive": true },
    { "permission": "steward.clipboard.write", "scope": "host=steward", "sensitive": true },
    { "permission": "steward.storage.get", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.storage.set", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.secrets.get", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.secrets.set", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.secrets.delete", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.secrets.list", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.calendar.holidays", "scope": "host=steward", "sensitive": true },
    { "permission": "steward.window.close", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.navigation.back", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.navigation.close", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.navigation.setTitle", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.fs.pick", "scope": "host=steward", "sensitive": true },
    { "permission": "steward.fs.walk", "scope": "path=<user-selected-root>", "sensitive": true },
    {
      "permission": "steward.fs.readText",
      "scope": "path=<user-selected-root>",
      "sensitive": true
    },
    {
      "permission": "steward.fs.writeText",
      "scope": "path=<user-selected-root>",
      "sensitive": true
    },
    { "permission": "steward.fs.grants", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.fs.cancelWalk", "scope": "host=steward", "sensitive": false },
    { "permission": "steward.system.applications", "scope": "system=installed", "sensitive": true },
    {
      "permission": "steward.system.openPath",
      "scope": "path=<user-selected-root>",
      "sensitive": true
    },
    {
      "permission": "steward.system.revealPath",
      "scope": "path=<user-selected-root>",
      "sensitive": true
    },
    {
      "permission": "steward.system.openWith",
      "scope": "path=<user-selected-root>;application=<installed-id>",
      "sensitive": true
    },
    {
      "permission": "steward.net.fetch",
      "scope": "host=<granted-host>;schemes=<allowed-schemes>;methods=<allowed-methods>;pathPrefixes=<allowed-prefixes>",
      "sensitive": true
    },
    { "permission": "steward.exec.run", "scope": "executable=<approved-exe>", "sensitive": true },
    { "permission": "steward.exec.cancel", "scope": "host=steward", "sensitive": false }
  ],
  "calls": [
    {
      "name": "steward.preferences.get",
      "family": "preferences",
      "capability": "steward.preferences.get",
      "transport": "call",
      "description": "Read one resolved host-owned preference value by key.",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key"],
        "properties": { "key": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "examples": [{ "key": "theme" }]
      },
      "response": {
        "type": ["string", "null"],
        "examples": ["dark"]
      }
    },
    {
      "name": "steward.preferences.all",
      "family": "preferences",
      "capability": "steward.preferences.all",
      "transport": "call",
      "description": "Read the complete resolved preference map for the current plugin.",
      "request": { "type": "null", "examples": [null] },
      "response": {
        "type": "object",
        "additionalProperties": true,
        "examples": [{ "theme": "dark" }]
      }
    },
    {
      "name": "steward.feedback.toast",
      "family": "feedback",
      "capability": "steward.feedback.toast",
      "transport": "call",
      "description": "Ask the launcher to render a transient informational notice.",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "message"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 128 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "examples": [{ "title": "Indexed", "message": "Repository index is ready." }]
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "examples": [{}]
      }
    },
    {
      "name": "steward.feedback.confirm",
      "family": "feedback",
      "capability": "steward.feedback.confirm",
      "transport": "call",
      "description": "Ask the user to confirm or cancel an action through a host-rendered dialog.",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "message"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 128 },
          "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "confirmLabel": { "type": "string", "maxLength": 64 },
          "cancelLabel": { "type": "string", "maxLength": 64 },
          "destructive": { "type": "boolean" }
        },
        "examples": [
          {
            "title": "Delete repository",
            "message": "Move this repository to the Recycle Bin?",
            "confirmLabel": "Move",
            "cancelLabel": "Cancel",
            "destructive": true
          }
        ]
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["confirmed"],
        "properties": { "confirmed": { "type": "boolean" } },
        "examples": [{ "confirmed": true }]
      }
    },
    {
      "name": "steward.feedback.progress",
      "family": "feedback",
      "capability": "steward.feedback.progress",
      "transport": "call",
      "description": "Publish bounded progress and receive a steward.progress event for the same plugin.",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "current": { "type": "integer", "minimum": 0 },
          "total": { "type": "integer", "minimum": 0 }
        },
        "examples": [{ "id": "index", "message": "Indexing", "current": 2, "total": 10 }]
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "examples": [{}]
      }
    },
    {
      "name": "steward.clipboard.history",
      "family": "clipboard",
      "capability": "steward.clipboard.history",
      "transport": "call",
      "description": "Read the newest bounded snapshot of host clipboard text entries.",
      "request": { "type": "null", "examples": [null] },
      "response": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "text", "copied_at"],
          "properties": {
            "id": { "type": "string" },
            "text": { "type": "string", "maxLength": 100000 },
            "copied_at": { "type": "integer" }
          }
        },
        "examples": [[{ "id": "42", "text": "Steward", "copied_at": 1763769600 }]]
      }
    },
    {
      "name": "steward.clipboard.write",
      "family": "clipboard",
      "capability": "steward.clipboard.write",
      "transport": "call",
      "description": "Replace the current host clipboard text with bounded plugin-provided text.",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": { "text": { "type": "string", "maxLength": 100000 } },
        "examples": [{ "text": "Steward" }]
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "examples": [{}]
      }
    },
    {
      "name": "steward.storage.get",
      "family": "storage",
      "capability": "steward.storage.get",
      "transport": "call",
      "description": "Read one string from plugin-private storage.",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key"],
        "properties": { "key": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "examples": [{ "key": "favorites" }]
      },
      "response": {
        "type": ["string", "null"],
        "examples": ["[]"]
      }
    },
    {
      "name": "steward.storage.set",
      "family": "storage",
      "capability": "steward.storage.set",
      "transport": "call",
      "description": "Persist one bounded string in plugin-private storage.",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 256 },
          "value": { "type": "string", "maxLength": 1048576 }
        },
        "examples": [{ "key": "favorites", "value": "[]" }]
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "examples": [{}]
      }
    },
    {
      "name": "steward.secrets.get",
      "family": "secrets",
      "capability": "steward.secrets.get",
      "transport": "call",
      "description": "Read one plugin-private secret from DPAPI-protected storage.",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key"],
        "properties": { "key": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "examples": [{ "key": "github-token" }]
      },
      "response": {
        "type": ["string", "null"],
        "examples": ["github_pat_example"]
      }
    },
    {
      "name": "steward.secrets.set",
      "family": "secrets",
      "capability": "steward.secrets.set",
      "transport": "call",
      "description": "Create or replace one plugin-private secret in DPAPI-protected storage.",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 128 },
          "value": { "type": "string", "maxLength": 2560 }
        },
        "examples": [{ "key": "github-token", "value": "github_pat_example" }]
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "examples": [{}]
      }
    },
    {
      "name": "steward.secrets.delete",
      "family": "secrets",
      "capability": "steward.secrets.delete",
      "transport": "call",
      "description": "Delete one plugin-private secret and report whether it existed.",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key"],
        "properties": { "key": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "examples": [{ "key": "github-token" }]
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deleted"],
        "properties": { "deleted": { "type": "boolean" } },
        "examples": [{ "deleted": true }]
      }
    },
    {
      "name": "steward.secrets.list",
      "family": "secrets",
      "capability": "steward.secrets.list",
      "transport": "call",
      "description": "List the names, but never the values, of this plugin's stored secrets.",
      "request": { "type": "null", "examples": [null] },
      "response": {
        "type": "array",
        "maxItems": 64,
        "items": { "type": "string" },
        "examples": [["github-token"]]
      }
    },
    {
      "name": "steward.calendar.holidays",
      "family": "calendar",
      "capability": "steward.calendar.holidays",
      "transport": "call",
      "description": "Read the cached holiday and adjusted-workday schedule for one year.",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["year"],
