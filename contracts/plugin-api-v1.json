      "capability": "steward.net.fetch",
      "transport": "call",
      "description": "Perform one scoped HTTPS request under active host, method, and path grants.",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "method", "timeoutMs"],
        "properties": {
          "url": { "type": "string", "format": "uri", "maxLength": 8192 },
          "method": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"] },
          "headers": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": { "type": "string" }
          },
          "body": { "type": "string", "maxLength": 1048576 },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 },
          "maxResponseBytes": { "type": "integer", "minimum": 1, "maximum": 4194304 }
        },
        "examples": [
          {
            "url": "https://api.github.com/rate_limit",
            "method": "GET",
            "headers": { "Accept": "application/vnd.github+json" },
            "timeoutMs": 10000,
            "maxResponseBytes": 262144
          }
        ]
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "url", "headers", "body", "redirects", "elapsedMs"],
        "properties": {
          "status": { "type": "integer" },
          "url": { "type": "string" },
          "headers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          },
          "body": { "type": "string" },
          "redirects": { "type": "integer", "minimum": 0 },
          "elapsedMs": { "type": "integer", "minimum": 0 }
        },
        "examples": [
          {
            "status": 200,
            "url": "https://api.github.com/rate_limit",
            "headers": [{ "name": "content-type", "value": "application/json" }],
            "body": "{\"rate\":{\"remaining\":59,\"limit\":60}}",
            "redirects": 0,
            "elapsedMs": 12
          }
        ]
      }
    },
